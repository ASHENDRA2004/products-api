@startuml

' show - and + as text instead of icons
skinparam classAttributeIconSize 0
scale 2

class Product {
  - id : Long
  - name : String
  - price : double
  + Product()
  + Product(id : Long, name : String, price : double)
  + getId() : Long
  + getName() : String
  + getPrice() : double
  + setId(id : Long) : void
  + setName(name : String) : void
  + setPrice(price : double) : void
}

class DigitalProduct {
  - downloadUrl : String
  - fileSizeMB : double
  + DigitalProduct()
  + DigitalProduct(id : Long, name : String, price : double, downloadUrl : String, fileSizeMB : double)
  + getDownloadUrl() : String
  + getFileSizeMB() : double
}

class PhysicalProduct {
  - weightKg : double
  - dimensions : String
  + PhysicalProduct()
  + PhysicalProduct(id : Long, name : String, price : double, weightKg : double, dimensions : String)
  + getWeightKg() : double
  + getDimensions() : String
}

class BundleProduct {
  - items : List<Product>
  + BundleProduct()
  + BundleProduct(id : Long, name : String, price : double, items : List<Product>)
  + getItems() : List<Product>
  + getItemCount() : int
}

' <|-- is the inheritance arrow. The PARENT goes on the left,
' so the hollow triangle touches Product.
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
Product <|-- BundleProduct

' Stretch: a bundle also HAS-A list of products (composition / aggregation)
BundleProduct o-- "0..*" Product : items

@enduml
